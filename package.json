{
  "name": "makersec",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted maker blog that reads markdown straight out of a GitHub repo.",
  "type": "module",
  "scripts": {
    "start": "bun src/server.js",
    "dev": "bun --watch src/server.js",
    "build": "bun src/build.js",
    "css": "tailwindcss -i src/styles.css -o public/style.css",
    "css:watch": "tailwindcss -i src/styles.css -o public/style.css --watch"
  },
  "dependencies": {
    "@shikijs/markdown-it": "^1.24.0",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "shiki": "^1.24.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0"
  },
  "engines": {
    "bun": ">=1.1"
  }
}
