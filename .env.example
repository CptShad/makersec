# ---------------------------------------------------------------
# Copy to .env next to docker-compose.yml and fill in.
#   cp .env.example .env
# ---------------------------------------------------------------

# Your name, shown in the footer of both sites.
SITE_AUTHOR=

# --- public blog -------------------------------------------------
PUBLIC_REPO=yourname/makersec-posts
PUBLIC_BRANCH=main
# Subfolder inside the repo holding the .md files. Empty = whole repo.
PUBLIC_CONTENT_DIR=
PUBLIC_TITLE=MakerSec
# Public origin, used for canonical URLs / RSS / sitemap.
PUBLIC_URL=https://blog.example.com
# Interface the public container binds to on the host (reverse proxy sits in front).
PUBLIC_BIND=0.0.0.0

# --- private notebook --------------------------------------------
PRIVATE_REPO=yourname/makersec-posts-private
PRIVATE_BRANCH=main
PRIVATE_CONTENT_DIR=
PRIVATE_TITLE=MakerSec Restricted
# IMPORTANT: bind the private site to your tailnet IP so it is only
# reachable over Tailscale. `tailscale ip -4` on den gives you this.
# Use 127.0.0.1 while testing.
PRIVATE_BIND=100.x.y.z

# --- GitHub ------------------------------------------------------
# Fine-grained PAT with "Contents: read-only" on the private repo
# (the public repo needs no token, but having one raises the API rate
# limit from 60/hr to 5000/hr, so set it either way).
GITHUB_TOKEN=github_pat_xxxxxxxx

# Shared secret for the GitHub push webhook (both repos can use the same one).
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# Seconds before the server re-checks GitHub for a new commit.
# Webhooks make this a fallback, so a couple of minutes is plenty.
CACHE_TTL=120
